[Unit]
Description=SafeNetic Backend API Server
Documentation=https://github.com/Sawaid-hub/safenetic_app
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=safenetic
Group=safenetic
WorkingDirectory=/opt/safenetic
ExecStart=/opt/safenetic/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=GOOGLE_APPLICATION_CREDENTIALS=/etc/safenetic/firebase-service-account.json

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/safenetic

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=safenetic

[Install]
WantedBy=multi-user.target
