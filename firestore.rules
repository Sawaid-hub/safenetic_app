rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validInitialDelivery(delivery) {
      return delivery is map
        && delivery.keys().hasOnly([
          'status', 'primary', 'fallback', 'provider', 'fallbackEligible',
          'successCount', 'failureCount', 'totalCount'
        ])
        && delivery.status == 'pending'
        && delivery.primary == 'firestore_cloud_function'
        && delivery.fallback == 'alerts_backend'
        && delivery.provider == 'firestore_cloud_function'
        && delivery.fallbackEligible == false
        && delivery.successCount == 0
        && delivery.failureCount == 0
        && delivery.totalCount == 0;
    }

    match /users/{uid} {
      function profileFields() {
        return [
          'uid', 'email', 'name', 'phone', 'profileImageUrl',
          'biometricEnabled', 'notificationsEnabled', 'sosDelay',
          'bloodType', 'medicalConditions', 'allergies',
          'fcmToken', 'fcmTokenUpdatedAt'
        ];
      }

      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(profileFields())
        && (
          ('uid' in request.resource.data && request.resource.data.uid == uid)
          || request.resource.data.keys().hasOnly(['fcmToken', 'fcmTokenUpdatedAt'])
        );
      allow update: if owns(uid)
        && request.resource.data.keys().hasOnly(profileFields())
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(profileFields());
      allow delete: if false;

      match /guardians/{guardianId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly([
            'id', 'name', 'phone', 'relationship', 'isActive', 'status', 'fcmToken'
          ]);
        allow delete: if owns(uid);
      }

      match /devices/{deviceId} {
        allow read, create, update: if owns(uid);
        allow delete: if owns(uid);
      }

      match /guardian_tokens/{guardianUid} {
        allow read: if owns(uid);
        allow create, update: if false;
        allow delete: if owns(uid)
          || (signedIn() && request.auth.uid == guardianUid);
      }

      match /server_metadata/{metadataId} {
        allow read, write: if false;
      }

      match /protected_links/{protectedUid} {
        allow read: if owns(uid);
        allow create, update: if false;
        allow delete: if owns(uid);
      }

      match /alerts/{alertId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.keys().hasOnly([
            'timestamp', 'latitude', 'longitude', 'guardianNames', 'guardianPhones',
            'type', 'status', 'smsResults', 'pushDelivery'
          ]);
        allow update: if owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'smsResults', 'pushDelivery', 'deliveryUpdatedAt'
          ]);
        allow delete: if owns(uid);
      }

      match /sos_events/{sosId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.keys().hasOnly([
            'userName', 'alertType', 'generatedAutomatically', 'timestamp', 'status',
            'delivery', 'location', 'latitude', 'longitude'
          ])
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 120
          && request.resource.data.alertType is string
          && request.resource.data.alertType.size() <= 40
          && request.resource.data.generatedAutomatically is bool
          && request.resource.data.timestamp is timestamp
          && request.resource.data.status == 'active'
          && validInitialDelivery(request.resource.data.delivery)
          && (
            !('latitude' in request.resource.data)
            || (request.resource.data.latitude is number
              && request.resource.data.latitude >= -90
              && request.resource.data.latitude <= 90)
          )
          && (
            !('longitude' in request.resource.data)
            || (request.resource.data.longitude is number
              && request.resource.data.longitude >= -180
              && request.resource.data.longitude <= 180)
          );
        allow update: if owns(uid)
          && resource.data.status == 'active'
          && request.resource.data.status == 'resolved'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt'])
          && request.resource.data.resolvedAt is timestamp;
        allow delete: if false;

      }
    }

    match /guardianInvites/{inviteId} {
      allow read, write: if false;
    }

    match /backend_rate_limits/{uid} {
      allow read, write: if false;
    }

    match /guardian_invite_limits/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
